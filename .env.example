# next configuration
# Un único .env en cada equipo. En el servidor usa su URL HTTPS y sus secretos.
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# database configuration
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=application_db
DB_USERNAME=postgres
DB_PASSWORD=application_db
DATABASE_URL="${DB_DRIVER}://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# s3 configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# domain configuration
SSL_EMAIL=
# El dominio del certificado se obtiene de NEXTAUTH_URL.

# resend configuration
RESEND_API_KEY=
EMAIL_FROM=

# GitHub OAuth configuration
# Development callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth configuration
# Development callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# verification email
VERIFICATION_EMAIL_ACTIVE=false

# structured logging (JSON to stdout/stderr)
LOG_LEVEL=info
LOG_SERVICE_NAME=event-manager
